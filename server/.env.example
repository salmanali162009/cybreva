# ─────────────────────────────────────────────
#  Cybreva — Environment variable reference
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────
# Format: mongodb+srv://<user>:<pass>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# ── JWT ───────────────────────────────────────
# Use a long, random string (e.g. openssl rand -base64 64)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d

# ── Frontend URL (for CORS) ───────────────────
CLIENT_URL=https://cybreva.vercel.app

# ── Cookie ────────────────────────────────────
# Number of days before the auth cookie expires
COOKIE_EXPIRE=7

# ── Groq AI ───────────────────────────────────
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# Optional — defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Threat Intelligence ────────────────
# Option A: Google Safe Browsing API (free, enabled via Google Cloud Console)
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key

# Option B: Google Web Risk API (paid, requires Cloud billing)
# https://cloud.google.com/web-risk/docs/quickstart
# GOOGLE_WEB_RISK_API_KEY=your_google_web_risk_api_key

# ── VirusTotal (optional) ─────────────────────
# Requires a VirusTotal account and compliance with their ToS and licensing.
# https://developers.virustotal.com/reference/overview
VIRUSTOTAL_API_KEY=your_virustotal_api_key
